# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
.tools/
dist/
dist-export/
dist-export-test*/
dist-prod-export/

# Local EAS archive inspection output (eas build:inspect)
inspect-archive-out/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.*
.env*.local

# EAS local Android signing (never commit)
credentials.json
secrets/

# Maestro run artifacts (keep committed PNGs under raw/screenshots/ only)
assets/store-screenshots/raw/20*/
assets/store-screenshots/raw/**/commands-*
assets/store-screenshots/raw/**/screenshot-*

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
