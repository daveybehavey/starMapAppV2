{
  "name": "star-map-app-final",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/generate-merchant-feed.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts tests next.config.mjs eslint.config.mjs playwright.config.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "test:ui": "playwright test",
    "preview": "node scripts/opennext-cloudflare.mjs preview",
    "deploy": "node scripts/opennext-cloudflare.mjs deploy",
    "deploy:safe": "node scripts/deploy-safe.mjs",
    "assets:examples": "node scripts/export-examples.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "check:env": "node scripts/check-env.mjs",
    "promo:setup": "node scripts/setup-promotion-code.mjs",
    "sync:static-home": "node scripts/sync-static-homepage.mjs",
    "check:static-home": "node scripts/sync-static-homepage.mjs --check",
    "seo:scoreboard": "node scripts/seo-scoreboard.mjs",
    "qa:live-conversion": "node scripts/live-conversion-qa.mjs",
    "qa:live-smoke": "node scripts/live-smoke.mjs --site https://starmapco.com",
    "qa:ga4-smoke": "node scripts/ga4-smoke.mjs",
    "qa:sitemap-health": "node scripts/sitemap-health.mjs",
    "qa:merchant-feed": "node scripts/merchant-feed-health.mjs",
    "qa:printful": "node scripts/printful-verify.mjs",
    "qa:print-ops": "node scripts/print-ops-report.mjs",
    "qa:print-margin": "node scripts/print-margin-audit.mjs",
    "qa:funnel-reconcile": "node scripts/funnel-reconcile.mjs",
    "qa:go-no-go": "node scripts/qa-go-no-go.mjs",
    "qa:smoke": "playwright test tests/ui-smoke.spec.ts tests/export-functionality.spec.ts tests/api-route-regressions.spec.ts tests/checkout-security.spec.ts tests/premium-rendering.spec.ts --workers=1",
    "qa:release-gate": "node scripts/qa-release-gate.mjs",
    "qa:release-gate:smoke": "node scripts/qa-release-gate.mjs --smoke",
    "qa:release-gate:live": "node scripts/qa-release-gate.mjs --live --sitemap https://starmapco.com/sitemap.xml",
    "qa:release-gate:live:smoke": "node scripts/qa-release-gate.mjs --smoke --live --sitemap https://starmapco.com/sitemap.xml"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "date-fns": "^4.1.0",
    "next": "16.1.6",
    "posthog-js": "^1.310.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "stripe": "^16.12.0",
    "tz-lookup": "^6.1.25",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.16.2",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^16.4.7",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.1.6",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.53.0"
  },
  "overrides": {
    "preact": "^10.28.2",
    "qs": "^6.14.1"
  }
}
