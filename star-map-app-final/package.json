{
  "name": "star-map-app-final",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "postinstall": "patch-package",
    "dev": "next dev",
    "prebuild": "node scripts/generate-merchant-feed.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src scripts tests next.config.mjs eslint.config.mjs playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test scripts/unit/*.test.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "test:ui": "node scripts/run-playwright-with-ci.mjs",
    "preview": "node scripts/opennext-cloudflare.mjs preview",
    "deploy": "node scripts/opennext-cloudflare.mjs deploy",
    "deploy:verify": "npm run deploy && npm run qa:live-critical",
    "deploy:safe": "node scripts/deploy-safe.mjs",
    "assets:examples": "node scripts/export-examples.mjs",
    "assets:printproof:drafts": "node scripts/create-printful-proof-drafts.mjs",
    "assets:printproof": "node scripts/sync-printful-proof-images.mjs",
    "assets:commerce-refresh": "node scripts/generate-merchant-feed.mjs && npm run qa:merchant-feed -- --file public/merchant-feed.xml",
    "assets:commerce-refresh:with-proof": "node -r dotenv/config scripts/sync-printful-proof-images.mjs dotenv_config_path=.env.local && npm run assets:commerce-refresh",
    "merchant:shipping-reference": "node scripts/generate-merchant-shipping-reference.mjs",
    "merchant:shipping-groups": "node scripts/generate-merchant-shipping-groups.mjs",
    "merchant:api:verify": "node scripts/merchant-api-verify.mjs",
    "merchant:shipping:plan": "node scripts/merchant-shipping-plan.mjs",
    "merchant:shipping:get": "node scripts/merchant-shipping-sync.mjs --get-current",
    "merchant:shipping:preview": "node scripts/merchant-shipping-sync.mjs",
    "merchant:shipping:apply": "node scripts/merchant-shipping-sync.mjs --apply",
    "merchant:shipping:verify": "node scripts/merchant-shipping-verify.mjs",
    "merchant:store-quality:facts": "node scripts/store-quality-facts.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "check:env": "node scripts/check-env.mjs",
    "promo:setup": "node scripts/setup-promotion-code.mjs",
    "sync:static-home": "node scripts/sync-static-homepage.mjs",
    "check:static-home": "node scripts/sync-static-homepage.mjs --check",
    "check:static-assets": "node scripts/check-static-assets.mjs",
    "seo:scoreboard": "node scripts/seo-scoreboard.mjs",
    "qa:live-conversion": "node scripts/live-conversion-qa.mjs",
    "qa:ga4-mp-probe": "node scripts/ga4-mp-probe.mjs",
    "qa:live-smoke": "node scripts/live-smoke.mjs --site https://starmapco.com",
    "qa:live-canary": "node scripts/live-smoke.mjs --site https://starmapco.com",
    "qa:live-critical": "node scripts/live-smoke.mjs --site https://starmapco.com --timeout-ms 12000",
    "qa:merch-marketing-smoke": "node scripts/merch-marketing-smoke.mjs --site http://localhost:3001",
    "qa:content-consistency": "node scripts/content-consistency-sweep.mjs --site https://starmapco.com",
    "qa:ga4-smoke": "node scripts/ga4-smoke.mjs",
    "qa:sitemap-health": "node scripts/sitemap-health.mjs",
    "qa:links": "node scripts/link-integrity-check.mjs",
    "qa:policy-smoke": "node scripts/policy-smoke.mjs --site https://starmapco.com",
    "qa:merchant-feed": "node scripts/merchant-feed-health.mjs",
    "qa:merchant-feed:live": "node scripts/merchant-feed-health.mjs --feed https://starmapco.com/merchant-feed.xml",
    "qa:merchant-center": "node scripts/qa-merchant-center.mjs",
    "qa:merchant-readiness": "npm run assets:commerce-refresh && npm run merchant:shipping-reference && npm run merchant:shipping-groups",
    "qa:printful": "node scripts/printful-verify.mjs",
    "qa:print-ops": "node scripts/print-ops-report.mjs",
    "qa:print-margin": "node scripts/print-margin-audit.mjs",
    "qa:stripe-payment-methods": "node scripts/stripe-payment-method-audit.mjs",
    "qa:upsell-matrix": "node scripts/generate-upsell-rollout-matrix.mjs",
    "qa:loop-scorecard": "node scripts/loop-scorecard.mjs",
    "qa:weekly-product": "npm run qa:loop-scorecard -- --days 14 && npm run qa:live-critical && npm run qa:print-margin",
    "qa:stripe-pmc": "node scripts/check-stripe-payment-methods.mjs",
    "qa:funnel-reconcile": "node scripts/funnel-reconcile.mjs",
    "qa:funnel-post-release": "npm run qa:funnel-reconcile -- --days 14",
    "qa:commerce-digest": "node scripts/commerce-digest.mjs",
    "qa:checkout-daily-ratio": "node scripts/checkout-daily-ratio-sanity.mjs",
    "qa:checkout-ratio-sanity": "node scripts/checkout-ratio-sanity.mjs",
    "qa:billing": "npm run qa:smoke:commerce && npm run qa:funnel-reconcile -- --days 14 && npm run qa:print-ops -- --hours 168 --limit 40",
    "qa:go-no-go": "node scripts/qa-go-no-go.mjs",
    "qa:go-no-go:strict": "node scripts/qa-go-no-go.mjs --strict-wrangler-parity",
    "qa:smoke:ui": "node scripts/run-playwright-with-ci.mjs tests/ui-smoke.spec.ts --workers=1",
    "qa:smoke:render": "node scripts/run-playwright-with-ci.mjs tests/export-functionality.spec.ts tests/premium-rendering.spec.ts --workers=1",
    "qa:smoke:commerce": "node scripts/run-playwright-with-ci.mjs tests/checkout-security.spec.ts tests/api-route-regressions.spec.ts --workers=1",
    "qa:smoke": "node scripts/run-playwright-with-ci.mjs tests/ui-smoke.spec.ts tests/export-functionality.spec.ts tests/api-route-regressions.spec.ts tests/checkout-security.spec.ts tests/premium-rendering.spec.ts --workers=1",
    "ci:pr": "npm run lint && npm run build && npm run qa:smoke:commerce",
    "qa:release-gate": "node scripts/qa-release-gate.mjs",
    "qa:release-gate:smoke": "node scripts/qa-release-gate.mjs --smoke",
    "qa:release-gate:live": "node scripts/qa-release-gate.mjs --live --sitemap https://starmapco.com/sitemap.xml",
    "qa:release-gate:live:smoke": "node scripts/qa-release-gate.mjs --smoke --live --sitemap https://starmapco.com/sitemap.xml",
    "qa:changed": "node scripts/qa-changed.mjs",
    "support:order-lookup": "node scripts/customer-order-lookup.mjs",
    "support:courtesy-replacement": "node scripts/support-courtesy-replacement.mjs",
    "seo:gsc:query": "node scripts/gsc-query.mjs"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "date-fns": "^4.1.0",
    "next": "16.1.6",
    "posthog-js": "^1.310.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "stripe": "^16.12.0",
    "tz-lookup": "^6.1.25",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.16.2",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^16.4.7",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.1.6",
    "patch-package": "^8.0.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.94.0"
  },
  "overrides": {
    "preact": "^10.28.2",
    "qs": "^6.14.1"
  }
}
