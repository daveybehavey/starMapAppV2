# Stripe Payment Processing
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET_HERE

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://starmapco.com

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_YOUR_POSTHOG_KEY_HERE
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_GA_ID=G-YOUR_GOOGLE_ANALYTICS_ID

# Pricing Configuration
PRICE_CENTS=99
PROMO_PRICE_CENTS=99
PROMO_START=2026-01-01
PROMO_END=2026-01-31
CURRENCY=usd
STRIPE_PROMO_CODE_ID=promo_YOUR_PROMO_CODE_ID_HERE

# Client-side Accessible Pricing (for banner/popup display)
NEXT_PUBLIC_PRICE_CENTS=99
NEXT_PUBLIC_PROMO_PRICE_CENTS=99
NEXT_PUBLIC_PROMO_START=2026-01-01
NEXT_PUBLIC_PROMO_END=2026-01-31
NEXT_PUBLIC_CURRENCY=usd
NEXT_PUBLIC_PROMO_ACTIVE=false

# Promotion email capture (optional automation)
PROMOTION_COUPON_CODE=20OFF
PROMOTION_COUPON_PERCENT=20
PROMOTION_COUPON_FIRST_TIME_ONLY=true
PROMOTION_COUPON_MAX_REDEMPTIONS=0
PROMOTION_EMAIL_SUBJECT=Your 20% off StarMapCo code
PROMOTION_EMAIL_FROM=StarMapCo <hello@updates.starmapco.com>
PROMOTION_EMAIL_REPLY_TO=support@starmapco.com

# Email delivery provider (configure one)
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
# SENDGRID_API_KEY=SG.YOUR_SENDGRID_KEY

# Optional fallback if you prefer your own automation endpoint
PROMOTION_AUTOMATION_WEBHOOK_URL=https://hooks.example.com/promotion-signup
